# Crypto provider: "local" (no GCP credentials needed) or "kms" (requires GCP)
CRYPTO_PROVIDER=local

# 32-byte master key as hex (used by local crypto provider only)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
LOCAL_MASTER_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Redis cache (optional — omit or leave empty to disable cache)
REDIS_URL=redis://localhost:6379/0

# Delegation grants: JSON mapping caller identity → list of authorized institution_ids
# Production: stored in Spanner delegation grant table, checked via Workload Identity
DELEGATION_GRANTS_JSON={"banno-payments@jh.iam": ["inst-001", "inst-002"], "silverlake-core@jh.iam": ["inst-001"]}

# Log level
LOG_LEVEL=INFO

# Cloud KMS settings (only required when CRYPTO_PROVIDER=kms)
# KMS_PROJECT=my-gcp-project
# KMS_LOCATION=us-central1
# KMS_KEY_RING=tokenization-keys
